PREFAB Moai
ENTITY Moai 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT ColliderComponent
        COLLIDER_INFO info CYLINDER_COLLIDER 1.646484375 4.21636962890625 1.646484375
        FLOAT restitution 0.0
        FLOAT friction 0.0
        VECTOR_3 positionOffset 0.0 0.10321044921875 0.0
        QUATERNION rotationOffset 0.0 0.0 0.0 1.0
        BOOL active false
        BOOL useGizmo false
        BOOL isTrigger false
    COMPONENT RenderComponent
        STRING meshName jordi-moai.glb
        STRING materialName 
    COMPONENT RigidBodyComponent
        FLOAT mass 0.0
        FLOAT linearDamping 0.0
        FLOAT angularDamping 0.0
        VECTOR_3 linearVelocity 0.0 0.0 0.0
        VECTOR_3 angularVelocity 0.0 0.0 0.0
        FLOAT linearSleepingThreshold 0.0
        FLOAT angularSleepingThreshold 0.0
        INT type 1
        BOOL dontRotateWithPhysicsOnDynamic false
        VECTOR_3 gravity 0.0 0.0 0.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

