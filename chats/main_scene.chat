SCENE main_scene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM DamageSystem
SYSTEM PlayerMovementSystem

ENTITY Jordi 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.08866310119629 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT PlayerComponent
        FLOAT jumpPower 500.0
        FLOAT xpPickupRange 5.0
        FLOAT objectPickupRange 1.0
        INT airJumps 0
    COMPONENT SpeedComponent
        FLOAT speed 5.0
    COMPONENT ColliderComponent
        COLLIDER_INFO info CYLINDER_COLLIDER 0.2021484375 0.747314453125 0.2021484375
        FLOAT restitution 0.0
        FLOAT friction 0.5
        VECTOR_3 positionOffset 0.0 0.99125957489014 0.0
        QUATERNION rotationOffset 0.0 0.00000008940698 0.0 1.0
        BOOL active true
        BOOL useGizmo true
    COMPONENT RigidBodyComponent
        FLOAT mass 5.0
        FLOAT linearDamping 0.0
        FLOAT angularDamping 0.0
        VECTOR_3 linearVelocity 0.0 0.0 0.0
        VECTOR_3 angularVelocity 0.0 0.0 0.0
        FLOAT linearSleepingThreshold 0.8
        FLOAT angularSleepingThreshold 1.0
    COMPONENT RenderComponent
        STRING meshName jordi.glb
        STRING materialName 
    START_CHILDREN
    ENTITY Camara 1
        COMPONENT TransformComponent
            VECTOR_3 position -1.34518647193909 0.73133689165115 -3.82007503509521
            QUATERNION rotation 0.0 0.98570495843887 0.0 -0.16848084330559
            VECTOR_3 scale 0.99999994039536 1.0 0.99999994039536
        COMPONENT CameraComponent
            INT projectionType 0
            FLOAT fovY 60.0
            FLOAT nearClip 1.0
            FLOAT farClip 10000.0
            FLOAT orthoWidth 10.0
            FLOAT orthoHeight 10.0
            BOOL autoAspectRatio true
            BOOL mainCamera true
            VECTOR_4 clearColor 0.0 0.0 0.0 1.0
        START_CHILDREN
        END_CHILDREN
    END_ENTITY

    END_CHILDREN
END_ENTITY

