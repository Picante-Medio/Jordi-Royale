SCENE main_scene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM ProjectileSystem
SYSTEM EnemyMovementSystem
SYSTEM ChangeSceneSystem
SYSTEM EnemySpawnSystem
SYSTEM PlayerMovementSystem

ENTITY Skybox 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT RenderComponent
        STRING meshName skybox.glb
        STRING materialName 
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Jordi 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 10.5824756622314 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT PlayerComponent
        FLOAT jumpPower 2000.0
        FLOAT xpPickupRange 5.0
        FLOAT objectPickupRange 1.0
        INT airJumps 0
    COMPONENT SpeedComponent
        FLOAT speed 80.0
    COMPONENT ColliderComponent
        COLLIDER_INFO info CYLINDER_COLLIDER 0.2021484375 0.86639404296875 0.2021484375
        FLOAT restitution 0.0
        FLOAT friction 1.0
        VECTOR_3 positionOffset 0.0 0.87217998504639 0.0
        QUATERNION rotationOffset 0.0 0.00000008940698 0.0 1.0
        BOOL active true
        BOOL useGizmo false
        BOOL isTrigger false
    COMPONENT RigidBodyComponent
        FLOAT mass 5.0
        FLOAT linearDamping 0.1
        FLOAT angularDamping 0.0
        VECTOR_3 linearVelocity 0.0 0.0 0.0
        VECTOR_3 angularVelocity 0.0 0.0 0.0
        FLOAT linearSleepingThreshold 0.8
        FLOAT angularSleepingThreshold 1.0
        INT type 0
        BOOL dontRotateWithPhysicsOnDynamic true
        VECTOR_3 gravity 0.0 -9.80000019073486 0.0
    COMPONENT RenderComponent
        STRING meshName jordi.glb
        STRING materialName 
    COMPONENT AnimationComponent
    START_CHILDREN
    END_CHILDREN
END_ENTITY

