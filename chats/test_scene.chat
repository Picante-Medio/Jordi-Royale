SCENE test_scene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem

ENTITY Jordi 0
	COMPONENT ColliderComponent
		FLOAT restitution 0.0
		FLOAT friction 0.0
		VECTOR_3 positionOffset 0.0 0.0 0.0
		QUATERNION rotationOffset 0.0 0.0 0.0 1.0
		BOOL active false
		BOOL useGizmo false
		INT info 0
	COMPONENT RigidBodyComponent
		FLOAT mass 0.0
		FLOAT linearDamping 0.0
		FLOAT angularDamping 0.0
		VECTOR_3 linearVelocity 0.0 0.0 0.0
		VECTOR_3 angularVelocity 0.0 0.0 0.0
		FLOAT linearSleepingThreshold 0.0
		FLOAT angularSleepingThreshold 0.0
	COMPONENT PlayerTag
	COMPONENT SpeedComponent
		FLOAT speed 5.0
	COMPONENT HPComponent
		INT HPMax 0
		INT CurrentHP 0
	COMPONENT JumpPowerComponent
		FLOAT power 10.0
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 0.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT RenderComponent
        STRING mesh Jordi.fbx
        STRING materialName

ENTITY CameraPivot 1
	COMPONENT ParentComponent
		INT parent 0
	COMPONENT CameraPivotTag
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.81992757320404 0.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0

ENTITY Camara 2
	COMPONENT ParentComponent
		INT parent 1
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 2.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0

