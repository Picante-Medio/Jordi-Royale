ENTITY Entity3D 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 -0.53464275598526
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT RotateComponent
    COMPONENT RenderComponent
        STRING meshName jordi.glb
        STRING materialName 
    START_CHILDREN
    ENTITY Entity3D 1
        COMPONENT TransformComponent
            VECTOR_3 position 1.43751764297485 0.0 0.0
            QUATERNION rotation 0.0 0.0 0.0 1.0
            VECTOR_3 scale 1.0 1.0 1.0
        COMPONENT RenderComponent
            STRING meshName cube.mesh
            STRING materialName 
        COMPONENT RotateComponent
        START_CHILDREN
        ENTITY Entity3D 1
            COMPONENT TransformComponent
                VECTOR_3 position 1.96999359130859 0.0 0.0
                QUATERNION rotation 0.0 0.0 0.0 1.0
                VECTOR_3 scale 1.0 1.0 1.0
            COMPONENT RenderComponent
                STRING meshName jordi.glb
                STRING materialName 
