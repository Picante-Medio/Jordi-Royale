SCENE upgrades_scene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM TransformSystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM UpgradeSystem
SYSTEM ChangeSceneSystem

ENTITY Camera 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT CameraComponent
        INT projectionType 0
        FLOAT fovY 60.0
        FLOAT nearClip 1.0
        FLOAT farClip 10000.0
        FLOAT orthoWidth 10.0
        FLOAT orthoHeight 10.0
        BOOL autoAspectRatio true
        BOOL mainCamera true
        VECTOR_4 clearColor 0.0 0.0 0.0 1.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Title 1
    COMPONENT PanelComponent
        STRING overlayName JordiUI/JordiOverlay1
        STRING containerName JordiUI/JordiOverlay10/JordiContainer1
        BOOL isVisible true
        INT metricsMode 0
        FLOAT left 0.35
        FLOAT top 0.05
        FLOAT width 0.3
        FLOAT height 0.1
        STRING material JordiUI/JordiUpgradesTitle
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Upgrade1 1
    COMPONENT PanelComponent
        STRING overlayName JordiUI/JordiOverlay2
        STRING containerName JordiUI/JordiOverlay3/JordiContainer2
        BOOL isVisible true
        INT metricsMode 0
        FLOAT left 0.08
        FLOAT top 0.25
        FLOAT width 0.25
        FLOAT height 0.6
        STRING material JordiUI/UpgradePanel_blue_regular
    COMPONENT ButtonComponent
        STRING normalMaterial JordiUI/UpgradePanel_blue_regular
        STRING hoverMaterial JordiUI/UpgradePanel_blue_selected
        STRING pressedMaterial JordiUI/UpgradePanel_blue_hover
        STRING disabledMaterial 
    COMPONENT ResumeTag
    START_CHILDREN
    END_CHILDREN
END_ENTITY

