SCENE pause_scene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM PauseSystem
SYSTEM ChangeSceneSystem

ENTITY pauseText 0
    COMPONENT PanelComponent
        STRING overlayName Pause/Title
        STRING containerName Pause/Title/Container
        STRING material Console/InputBackground
        BOOL isVisible true
        FLOAT left 0.25
        FLOAT top 0.2
        FLOAT width 0.5
        FLOAT height 0.2
    COMPONENT TextComponent
        STRING text PAUSE
        STRING textAreaName pause
        VECTOR_4 colourTop 0.0 0.0 0.0 1.0
        VECTOR_4 colourBottom 0.0 0.0 0.0 1.0
        VECTOR_4 colour 0.0 0.0 0.0 1.0
        FLOAT characterHeight 0.1
        FLOAT spaceWidth 0.6
        STRING textFont Roboto
        FLOAT left 0.1
        FLOAT top 0.1

ENTITY resumeButton 1
    COMPONENT PanelComponent
        STRING overlayName Pause/Resume
        STRING containerName Pause/Resume/Container
        STRING material Console/InputBackground
        BOOL isVisible true
        FLOAT left 0.25
        FLOAT top 0.5
        FLOAT width 0.2
        FLOAT height 0.08
    COMPONENT TextComponent
        STRING text RESUME
        STRING textAreaName resume
        VECTOR_4 colourTop 0.0 0.0 0.0 1.0
        VECTOR_4 colourBottom 0.0 0.0 0.0 1.0
        VECTOR_4 colour 0.0 0.0 0.0 1.0
        FLOAT characterHeight 0.04
        FLOAT spaceWidth 0.025
        STRING textFont Roboto
        FLOAT left 0.1
        FLOAT top 0.1
    COMPONENT ButtonComponent
        STRING normalMaterial UI/Button
        STRING hoverMaterial UI/Hover
        STRING pressedMaterial UI/Pressed
        STRING disabledMaterial prueba/Disabled
    COMPONENT ResumeTag


ENTITY returnButton 2
    COMPONENT PanelComponent
        STRING overlayName Pause/Return
        STRING containerName Pause/Return/Container
        STRING material Console/InputBackground
        BOOL isVisible true
        FLOAT left 0.5
        FLOAT top 0.5
        FLOAT width 0.2
        FLOAT height 0.08
    COMPONENT TextComponent
        STRING text RETURN
        STRING textAreaName return
        VECTOR_4 colourTop 0.0 0.0 0.0 1.0
        VECTOR_4 colourBottom 0.0 0.0 0.0 1.0
        VECTOR_4 colour 0.0 0.0 0.0 1.0
        FLOAT characterHeight 0.04
        FLOAT spaceWidth 0.025
        STRING textFont Roboto
        FLOAT left 0.1
        FLOAT top 0.1
    COMPONENT ButtonComponent
        STRING normalMaterial UI/Button
        STRING hoverMaterial UI/Hover
        STRING pressedMaterial UI/Pressed
        STRING disabledMaterial prueba/Disabled

ENTITY camera 3
    COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.81999999284744 4.05000019073486
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0
	COMPONENT CameraComponent
		INT projectionType 0
		FLOAT fovY 60.0
		FLOAT nearClip 1.0
		FLOAT farClip 10000.0
		FLOAT orthoWidth 10.0
		FLOAT orthoHeight 10.0
		BOOL autoAspectRatio true
		BOOL mainCamera true
		VECTOR_4 clearColor 0.0 0.0 0.0 1.0