SCENE DynamicAudioScene
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM TransformSystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM AudioEventsSystem
SYSTEM DynamicAudioSystem

ENTITY Music 1
    START_CHILDREN
    ENTITY Arpegio 1
        COMPONENT AudioComponent
            STRING audioName arpegiotrack
            FLOAT volume 0.0
            BOOL loop true
            FLOAT pitch 0.0
            BOOL isPlaying false
        COMPONENT DynamicAudioComponent
            FLOAT maxVolume 1.0
            FLOAT minVolume 0.0
            STRING audioName arpegiotrack
            FLOAT interpolationMiliseconds 1500.0
        COMPONENT TweenComponent
        START_CHILDREN
        END_CHILDREN
    END_ENTITY

    ENTITY Bass 1
        COMPONENT AudioComponent
            STRING audioName basstrack
            FLOAT volume 0.0
            BOOL loop true
            FLOAT pitch 0.0
            BOOL isPlaying false
        COMPONENT DynamicAudioComponent
            FLOAT maxVolume 1.0
            FLOAT minVolume 0.0
            STRING audioName basstrack
            FLOAT interpolationMiliseconds 1500.0
        COMPONENT TweenComponent
        START_CHILDREN
        END_CHILDREN
    END_ENTITY

    ENTITY Chords 1
        COMPONENT AudioComponent
            STRING audioName chordstrack
            FLOAT volume 0.0
            BOOL loop true
            FLOAT pitch 0.0
            BOOL isPlaying false
        COMPONENT DynamicAudioComponent
            FLOAT maxVolume 1.0
            FLOAT minVolume 0.0
            STRING audioName chordstrack
            FLOAT interpolationMiliseconds 1500.0
        COMPONENT TweenComponent
        START_CHILDREN
        END_CHILDREN
    END_ENTITY

    ENTITY Melody 1
        COMPONENT AudioComponent
            STRING audioName melodytrack
            FLOAT volume 0.0
            BOOL loop true
            FLOAT pitch 0.0
            BOOL isPlaying false
        COMPONENT DynamicAudioComponent
            FLOAT maxVolume 1.0
            FLOAT minVolume 0.0
            STRING audioName melodytrack
            FLOAT interpolationMiliseconds 1500.0
        COMPONENT TweenComponent
        START_CHILDREN
        END_CHILDREN
    END_ENTITY

    END_CHILDREN
END_ENTITY

ENTITY Camera 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 1.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT CameraComponent
        INT projectionType 0
        FLOAT fovY 60.0
        FLOAT nearClip 1.0
        FLOAT farClip 10000.0
        FLOAT orthoWidth 10.0
        FLOAT orthoHeight 10.0
        BOOL autoAspectRatio true
        BOOL mainCamera false
        VECTOR_4 clearColor 0.30000001192093 0.30000001192093 0.5 1.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

