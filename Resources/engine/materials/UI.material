material UI/Button
{
    technique
    {
        pass
        {
            lighting off
            diffuse 1 1 1 1

            texture_unit
            {
                colour_op_ex source1 src_manual src_current 1 1 1 1
            } 
        }
    }
}
material UI/Hover
{
    technique
    {
        pass
        {
            lighting off
            diffuse 0.5 0.5 0.5 1 

