// material for Overlays
// WE HAVE TO add texture_unit!!!!!
material UI/Test
{
    technique
    {
        pass
        {
            // MUST BE INCLUDED
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture spaceSky.jpg
                colour_op replace
            }
        }
    }
}
